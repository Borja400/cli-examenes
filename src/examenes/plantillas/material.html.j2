<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ material.titulo }}</title>
<style>
  :root { color-scheme: light; }
  body {
    max-width: 900px;
    margin: 2rem auto;
    padding: 0 1rem;
    color: #222;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    line-height: 1.6;
  }
  h1, h2, h3 { color: #173d63; line-height: 1.25; }
  h1 { border-bottom: 2px solid #173d63; padding-bottom: .4rem; }
  h2 { margin-top: 2rem; }
  .meta { color: #555; padding-left: 1.2rem; }
  .texto { white-space: pre-wrap; }
  .descripcion {
    background: #f4f7fb;
    border-left: 4px solid #173d63;
    padding: .6rem .8rem;
    white-space: pre-wrap;
  }
  .pregunta, .ejercicio, .tema {
    border: 1px solid #d9e2ec;
    border-radius: 6px;
    padding: .8rem 1rem;
    margin: 1rem 0;
  }
  .solucion {
    background: #eef6ee;
    border-left: 4px solid #2e7d32;
    padding: .6rem .8rem;
    margin-top: .6rem;
    white-space: pre-wrap;
  }
  .pistas { color: #555; }
  ul { margin-top: .3rem; }
  @media print {
    body { max-width: none; margin: 0; }
    .pregunta, .ejercicio, .tema { break-inside: avoid; }
  }
</style>
</head>
<body>
<header>
  <h1>{{ material.titulo }}</h1>
  {% if material.descripcion %}
  <p class="descripcion">{{ material.descripcion }}</p>
  {% endif %}
  <ul class="meta">
    {% if material.modulo %}<li><strong>Módulo:</strong> {{ material.modulo }}</li>{% endif %}
    {% if material.curso %}<li><strong>Curso:</strong> {{ material.curso }}</li>{% endif %}
    {% if material.autor %}<li><strong>Autor:</strong> {{ material.autor }}</li>{% endif %}
    {% if material.fecha %}<li><strong>Fecha:</strong> {{ material.fecha }}</li>{% endif %}
  </ul>
</header>

{% if material.objetivos %}
<section>
  <h2>Objetivos</h2>
  <ul>
    {% for objetivo in material.objetivos %}
    <li>{{ objetivo }}</li>
    {% endfor %}
  </ul>
</section>
{% endif %}

<section>
  <h2>Temario</h2>
  {% for tema in material.temas %}
  <article class="tema">
    <h3>{{ tema.id }} · {{ tema.titulo }}</h3>
    {% if tema.resumen %}
    <div class="texto">{{ tema.resumen }}</div>
    {% endif %}
    {% if tema.puntos_clave %}
    <p><strong>Puntos clave:</strong></p>
    <ul>
      {% for punto in tema.puntos_clave %}
      <li>{{ punto }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if tema.recursos %}
    <p><strong>Recursos:</strong></p>
    <ul>
      {% for recurso in tema.recursos %}
      <li>{{ recurso }}</li>
      {% endfor %}
    </ul>
    {% endif %}
  </article>
  {% endfor %}
</section>

{% if material.preguntas %}
<section>
  <h2>Preguntas</h2>
  {% for pregunta in material.preguntas %}
  <article class="pregunta">
    <h3>{{ pregunta.id }} · {{ pregunta.tipo | capitalize }}</h3>
    <p><strong>Dificultad:</strong> {{ pregunta.dificultad }}{% if pregunta.tema %} · <strong>Tema:</strong> {{ pregunta.tema }}{% endif %}</p>
    <div class="texto">{{ pregunta.enunciado }}</div>
    {% if pregunta.opciones %}
    <ul>
      {% for opcion in pregunta.opciones %}
      <li>{{ opcion }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if mostrar_soluciones %}
      {% if pregunta.respuesta %}
      <div class="solucion"><strong>Respuesta:</strong> {{ pregunta.respuesta }}</div>
      {% endif %}
      {% if pregunta.explicacion %}
      <div class="solucion"><strong>Explicación:</strong> {{ pregunta.explicacion }}</div>
      {% endif %}
    {% endif %}
  </article>
  {% endfor %}
</section>
{% endif %}

{% if material.ejercicios %}
<section>
  <h2>Ejercicios</h2>
  {% for ejercicio in material.ejercicios %}
  <article class="ejercicio">
    <h3>{{ ejercicio.id }} · {{ ejercicio.titulo }}</h3>
    <div class="texto">{{ ejercicio.enunciado }}</div>
    {% if ejercicio.pistas %}
    <p class="pistas"><strong>Pistas:</strong></p>
    <ul class="pistas">
      {% for pista in ejercicio.pistas %}
      <li>{{ pista }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if mostrar_soluciones and ejercicio.solucion %}
    <div class="solucion"><strong>Solución:</strong><br>{{ ejercicio.solucion }}</div>
    {% endif %}
  </article>
  {% endfor %}
</section>
{% endif %}
</body>
</html>
